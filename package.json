{
  "name": "seraphimon",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.x"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "prebuild": "node scripts/generate-handoff-manifest.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "jest",
    "test:quick": "jest --bail --maxWorkers=2 --passWithNoTests",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "check:redis": "tsx scripts/check-redis.ts",
    "test:production": "NODE_ENV=production npm run check:redis",
    "test:e2e": "npx playwright test",
    "test:e2e:ui": "npx playwright test --ui",
    "test:e2e:report": "npx playwright show-report",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "types:generate": "npx supabase gen types typescript --local > src/types/database.types.ts",
    "db:start": "npx supabase start",
    "db:stop": "npx supabase stop",
    "db:reset": "npx supabase db reset",
    "db:sync": "node scripts/sync-prod-to-local.mjs",
    "db:generate-seed": "node scripts/generate-seed.mjs"
  },
