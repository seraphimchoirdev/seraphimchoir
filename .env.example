# Supabase 설정
# 로컬 개발: `npx supabase start` 실행 후 출력되는 URL/키 사용
#   URL: http://127.0.0.1:54321
#   키: 터미널 출력에서 복사
# 프로덕션: https://your-project.supabase.co (Vercel 환경변수로 설정)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Upstash Redis (Rate Limiting용) - 프로덕션 환경에서 권장
# https://upstash.com/ 에서 무료 계정 생성 후 Redis 데이터베이스 생성
# Primary region: Tokyo (ap-northeast-1) 권장 (한국에서 가장 빠름)
UPSTASH_REDIS_REST_URL=https://xxx-xxx-xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=AXX...

# Web Push (VAPID) 설정
# `npx web-push generate-vapid-keys`로 키 쌍을 1회 발급하여 설정
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto: 이메일 또는 https: URL (푸시 서비스 사업자에게 노출되는 연락처)
VAPID_SUBJECT=mailto:admin@example.com

# Vercel Cron 인증 시크릿 (예약 알림 발송 라우트 보호용, 랜덤 문자열)
CRON_SECRET=

# Sentry 에러 트래킹 (https://sentry.io/)
# 프로덕션 환경에서 에러를 자동으로 Sentry에 리포트합니다.
# 1. Sentry 계정 생성: https://sentry.io/signup/
# 2. 새 프로젝트 생성 (Platform: Next.js 선택)
# 3. DSN 복사 후 아래에 설정
NEXT_PUBLIC_SENTRY_DSN=

# 소스맵 업로드용 (선택적, 프로덕션 디버깅 시 필요)
# Sentry > Settings > Developer Settings > Auth Tokens에서 생성
# Scope: "project:releases" and "project:write" 필요
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Cloudflare R2 (파일 스토리지)
# Cloudflare 대시보드 > R2 > API 토큰에서 생성
# 버킷 2개 필요: seraphim-public (공개), seraphim-private (비공개)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
NEXT_PUBLIC_R2_PUBLIC_URL=https://pub-xxxx.r2.dev

# Vercel Analytics (선택사항)
# Vercel 프로젝트에서 자동으로 활성화됨
# 로컬 테스트 시에만 필요
NEXT_PUBLIC_VERCEL_ANALYTICS_MODE=production
VERCEL_ANALYTICS_ID=
